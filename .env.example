# AT Protocol credentials (required)
ATP_SERVICE=https://bsky.social
ATP_HANDLE=your-handle.bsky.social
ATP_PASSWORD=your-app-password

# Setup-file coordinates retained for compatibility and documentation.
# The register command's --lat/--lon arguments are authoritative, and the
# resulting station location is public AT Protocol data.
RECEIVER_LAT=38.8977
RECEIVER_LON=-77.0365

# Stream signing (optional, generate with: at-adsb generate-stream-key)
# STREAM_SIGNING_KEY_HEX=

# Daemon settings
WS_PORT=4100
BATCH_WINDOW_S=60
STATS_INTERVAL_M=60
QUEUE_DB_PATH=/data/at-adsb-queue.db

# Adapter settings. Docker Compose uses the host-gateway default below.
# On Linux, use --add-host=host.docker.internal:host-gateway or a LAN IP.
# The source adapter fallback remains http://localhost:8080 when READSB_URL is absent.
READSB_URL=http://host.docker.internal:8080
POLL_INTERVAL_S=5

# Raw capture (optional, uncomment to enable BEAST frame capture)
# BEAST_HOST=readsb
# BEAST_PORT=30005
