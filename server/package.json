{
  "name": "at-adsb-cli",
  "version": "0.1.0",
  "description": "CLI utility for publishing ADS-B receiver data to the AT Protocol network.",
  "type": "module",
  "bin": {
    "at-adsb": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@atproto/api": "^0.20.5",
    "@atproto/crypto": "^0.5.0",
    "@atproto/xrpc-server": "^0.11.1",
    "@ipld/dag-cbor": "^10.0.1",
    "better-sqlite3": "^12.10.0",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
