# AT Protocol credentials (required)
ATP_HANDLE=your-receiver.bsky.social
ATP_PASSWORD=your-app-password

# AT Protocol service (optional, defaults to https://bsky.social)
# ATP_SERVICE=https://bsky.social

# readsb URL (required)
READSB_URL=http://localhost:8080

# Poll interval in seconds (optional, default: 5)
# POLL_INTERVAL_S=5

# Stats publish interval in minutes (optional, default: 60)
# STATS_INTERVAL_M=60

# Publish queue database path (optional, default: ./at-adsb-queue.db)
# QUEUE_DB_PATH=./at-adsb-queue.db

# Receiver location is fetched from station record on startup (at.adsb.receiver.station/self)
# Run 'at-adsb register' first to set up your receiver
